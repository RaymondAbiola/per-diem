# Owner: deploys, funds the cap, sets the budget.
PRIVATE_KEY=0x

# Agent: submits metered calls and gets reimbursed per call. Needs a small
# USDC float on Arc to front gas with.
AGENT_KEY=0x

# Arc mainnet. Gas is USDC here, so bridged USDC funds everything.
RPC_URL=https://rpc.mainnet.arc.io

# Calibration rounds to run before recommending a tailGas.
ROUNDS=5
